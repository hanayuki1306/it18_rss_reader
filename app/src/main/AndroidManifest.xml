<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cấp quyền truy cập Internet để tải dữ liệu RSS và load bài viết[cite: 3] -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RssReaderApp">

        <!-- Màn hình chính khởi động đầu tiên[cite: 3, 5] -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Màn hình đọc chi tiết bài viết[cite: 5, 6] -->
        <activity
            android:name=".activities.DetailActivity"
            android:exported="false" />

        <!-- Màn hình xem danh sách tin đã lưu[cite: 5, 6] -->
        <activity
            android:name=".activities.SavedNewsActivity"
            android:exported="false" />

    </application>

</manifest>